{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f11235af256c458fae7c8cdad0ae385d",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CalculateMultiLightSpaceShading (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -344.0000305175781,
            "y": -396.0,
            "width": 321.00006103515625,
            "height": 142.00001525878906
        }
    },
    "m_Slots": [
        {
            "m_Id": "1f454891d7064740ad5f57607fbddb2f"
        },
        {
            "m_Id": "2ddaa88c2a634b7c8c30e9d6928d0602"
        },
        {
            "m_Id": "ffd1e24a73e44677a8c745886169b78d"
        },
        {
            "m_Id": "7a961b44d00f4aa4b5d504e17a84a2e5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "CalculateMultiLightSpaceShading",
    "m_FunctionSource": "074591514d484cc42b5609b712320927",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "CalculateMultiSphereShadow_float(\n    float3 Position_World, \n    float3 StarPos, \n    float Count, \n    out float ShadowAttenuation)\n{\n    // Start fully illuminated (1.0 = no shadow)\n    float combinedAttenuation = 1.0;\n    \n    // Calculate the direction vector from the current pixel directly to the star\n    float3 lightDir = normalize(StarPos - Position_World);\n    \n    // Loop through all active shadow-casting objects in the area\n    int numOccluders = min(16, (int)Count);\n    for (int i = 0; i < numOccluders; i++)\n    {\n        // Access the global shader arrays natively mapped by Unity's engine\n        float3 occluderCenter = _OccluderPositions[i].xyz;\n        float radius = _OccluderRadii[i];\n        float softness = _OccluderSoftness[i];\n        \n        // Vector from current pixel to the center of the shadow caster\n        float3 v = occluderCenter - Position_World;\n        \n        // Project the occluder's position onto the light ray vector\n        float projection = dot(v, lightDir);\n        \n        // If the occluder is behind this surface pixel relative to the star, skip it\n        if (projection > 0.0)\n        {\n            // Find the closest point along the light ray path to the occluder center\n            float3 closestPoint = Position_World + lightDir * projection;\n            \n            // Perpendicular distance from our surface pixel to the shadow centerline\n            float dist = distance(occluderCenter, closestPoint);\n            \n            // Calculate a soft contact-hardening falloff (penumbra)\n            float currentShadow = smoothstep(radius, radius + softness, dist);\n            \n            // Multiply attenuation so multiple overlapping shadows compound realistically\n            combinedAttenuation *= currentShadow;\n        }\n    }\n    \n    // Output the final computed shading factor\n    ShadowAttenuation = combinedAttenuation;\n}"
}

