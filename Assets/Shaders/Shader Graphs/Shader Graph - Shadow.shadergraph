{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c344e6e94f29475999644f15896499e3",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Capsule_shadow_1 (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -316.0000305175781,
            "y": -353.00006103515625,
            "width": 296.0,
            "height": 190.00001525878906
        }
    },
    "m_Slots": [
        {
            "m_Id": "4c5a89ca4525499591f85aa3213f4d94"
        },
        {
            "m_Id": "79247d2090ab467e9de69407266d2278"
        },
        {
            "m_Id": "6d5a7e604172423892a4b4d811b7dd7b"
        },
        {
            "m_Id": "80683c3f7a3e470eab61a53eb93f40d1"
        },
        {
            "m_Id": "da9eedb85b2a486381dc48b71957dca0"
        },
        {
            "m_Id": "cea56aa67e8e4be4a1c75cd6ec5fc3aa"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Capsule_shadow_1",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Calculate direction vectors\nfloat3 rayOrigin = Position_Home;\nfloat3 lightDir = normalize(Position_Light - Position_Occluder); // Direction shadow travels\n\n// Project the world position onto the shadow line\nfloat3 v = rayOrigin - Position_Occluder;\nfloat projection = dot(v, lightDir);\n\n// We only want shadows cast away from the light source\nprojection = max(0.0, projection);\n\n// Find the closest point on the shadow ray line to our current surface pixel\nfloat3 closestPoint = Position_Occluder + lightDir * projection;\n\n// Calculate the distance from our pixel to that shadow centerline\nfloat dist = distance(rayOrigin, closestPoint);\n\n// Smoothstep creates the soft falloff edge of the shade\nShadowAttenuation = smoothstep(Radius, Radius + Softness, dist);"
}

